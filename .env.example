# Copy this file to .env and replace every "replace-with-..." value.
# Never commit .env or put real credentials in this template.

# Local infrastructure -------------------------------------------------------
# Use strong, unique passwords. Keep each password synchronized with the
# corresponding URL below. URL-encode reserved characters used inside URLs.
POSTGRES_PASSWORD=replace-with-strong-postgres-password
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

# Bot application and scheduler ---------------------------------------------
# Required: Telegram bot token issued by BotFather.
APP_BOT_TOKEN=replace-with-telegram-bot-token
APP_DATABASE_URL=postgresql+asyncpg://ai_manager:replace-with-strong-postgres-password@postgres/ai_manager
APP_REDIS_URL=redis://redis:6379/0
APP_RABBITMQ_URL=amqp://ai_manager:replace-with-strong-rabbitmq-password@rabbitmq/
APP_VOICE_DIRECTORY=/var/lib/ai-manager/voice
# Whole-Star amount for a recurring 30-day subscription.
APP_STARS_PRICE=500
# Optional comma-separated Telegram user IDs with unlimited voice usage.
APP_VOICE_WHITELIST=
APP_LOG_LEVEL=INFO

# Transcription worker -------------------------------------------------------
VOICE_RABBITMQ_URL=amqp://ai_manager:replace-with-strong-rabbitmq-password@rabbitmq/
VOICE_VOICE_DIRECTORY=/var/lib/ai-manager/voice
VOICE_WHISPER_BINARY=/usr/local/bin/whisper-cli
VOICE_WHISPER_MODEL=/models/ggml-small.bin
# Use "auto" for language detection or a whisper.cpp language code.
VOICE_LANGUAGE=auto

# AI worker ------------------------------------------------------------------
AI_RABBITMQ_URL=amqp://ai_manager:replace-with-strong-rabbitmq-password@rabbitmq/
# Required: Gemini API key. Never expose it in client-side code or Git history.
AI_GEMINI_API_KEY=replace-with-gemini-api-key
AI_GEMINI_MODEL=gemini-3.5-flash-lite

# Host path mounted read-only at VOICE_WHISPER_MODEL inside the container.
WHISPER_MODEL_PATH=./models/ggml-small.bin
